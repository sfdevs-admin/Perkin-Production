<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calls_Answer_in_20_Sec__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
AND(
NOT(ISBLANK(CallAcceptDateTime)),
NOT(ISBLANK(CallQueuedDateTime)),
(CallAcceptDateTime- CallQueuedDateTime) * 24 * 60 * 60 &lt; 20
),
1,
0
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Calls Answer in 20 Sec</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
